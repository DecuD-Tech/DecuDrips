  "query": "\n        INSERT INTO users (github_id, username, avatar_url)\n        VALUES ($1, $2, $3)\n        ON CONFLICT (github_id) DO UPDATE\n        SET username = EXCLUDED.username,\n            avatar_url = EXCLUDED.avatar_url\n        RETURNING id, github_id, username, avatar_url, role, created_at\n        ",
