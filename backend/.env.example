# DocuDrip Backend Environment Variables
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/docudrip
REDIS_URL=redis://127.0.0.1:6379

# JWT secret
JWT_SECRET=supersecretjwtkeyforlocaldevelopmentonlychangeinprod

# GitHub OAuth Setup
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:8080/api/auth/callback
